<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SpaRoot>GuildedThorn.com-Frontend/</SpaRoot>
    <SpaProxyServerUrl>https://localhost:5173</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>bun run dev</SpaProxyLaunchCommand>
    <SpaProxyApplyProxyToSpaDevelopmentServer>true</SpaProxyApplyProxyToSpaDevelopmentServer>
    <Nullable>enable</Nullable>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNet.Security.OAuth.Spotify" Version="10.0.0" />
    <!-- S3-compatible object storage client — points at a self-hosted
         SeaweedFS S3 endpoint, not AWS. See Services/S3StorageService.cs. -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.100" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <!-- WebAuthn / FIDO2 (YubiKey). Fido2.AspNet provides the AddFido2() DI
         extension and pulls in the core Fido2 package. Verify the latest 4.x. -->
    <PackageReference Include="Fido2.AspNet" Version="4.0.1" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <!-- Pure managed git (no external git binary — the runtime image doesn't
         have one) used by KnowledgeBaseSyncEngine to mirror the public
         GuildedThorn/knowledge-base vault. -->
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.9" />
    <PackageReference Include="Microsoft.Bcl.Cryptography" Version="10.0.9" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.1" />
    <PackageReference Include="MongoDB.Bson" Version="3.9.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.9.0" />
    <!-- Stubbed (AddOpenIddict().AddCore(_ => { }), no store, no client
         registrations) — safe to bump freely, nothing depends on its behavior
         yet. OpenIddict 7.0's "database migration required" note doesn't
         apply since no persistence store is configured. -->
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.5.0" />
    <PackageReference Include="OpenIddict.Client.AspNetCore" Version="7.5.0" />
    <PackageReference Include="RabbitMQ.Client" Version="7.1.2" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Grafana.Loki" Version="8.3.1" />
    <PackageReference Include="Stripe.net" Version="52.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.1" />
    <PackageReference Include="WebPush" Version="1.0.12" />
    <!-- Same-origin reverse proxy for the self-hosted live stream: forwards
         /stream/* to the local Owncast (RTMP→HLS) media server. -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unit tests live in Tests/ and are compiled by Tests/GuildedThorn.Tests.csproj.
         The Web SDK globs **/*.cs, so exclude them from the web app build. -->
    <Compile Remove="Tests/**/*.cs" />
    <Content Remove="Tests/**/*" />
  </ItemGroup>

