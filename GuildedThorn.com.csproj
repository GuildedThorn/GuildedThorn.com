<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <SpaRoot>GuildedThorn.com-Frontend/</SpaRoot> 
    <SpaProxyLaunchCommanVd>npm run dev</SpaProxyLaunchCommanVd>
    <SpaProxyServerUrl>https://localhost:5173</SpaProxyServerUrl>
    <SpaProxyApplyProxyToSpaDevelopmentServer>true</SpaProxyApplyProxyToSpaDevelopmentServer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.0-preview.3.25172.1" />
    <PackageReference Include="Microsoft.AspNetCore.SpaServices" Version="3.1.32" />
    <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="9.0.4" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.1" />
  </ItemGroup>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="GuildedThorn.com-Frontend\package-lock.json" />
    <_ContentIncludedByDefault Remove="GuildedThorn.com-Frontend\package.json" />
    <_ContentIncludedByDefault Remove="GuildedThorn.com-Frontend\tsconfig.app.json" />
    <_ContentIncludedByDefault Remove="GuildedThorn.com-Frontend\tsconfig.json" />
    <_ContentIncludedByDefault Remove="GuildedThorn.com-Frontend\tsconfig.node.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\GuildedThorn.com-Frontend\.gitignore" />
    <None Include="wwwroot\GuildedThorn.com-Frontend\eslint.config.js" />
    <None Include="wwwroot\GuildedThorn.com-Frontend\index.html" />
    <None Include="wwwroot\GuildedThorn.com-Frontend\public\vite.svg" />
    <None Include="wwwroot\GuildedThorn.com-Frontend\README.md" />
    <None Include="wwwroot\GuildedThorn.com-Frontend\src\App.css" />
    <None Include="wwwroot\GuildedThorn.com-Frontend\src\App.tsx" />
    <None Include="wwwroot\GuildedThorn.com-Frontend\src\assets\react.svg" />
    <None Include="wwwroot\GuildedThorn.com-Frontend\src\index.css" />
    <None Include="wwwroot\GuildedThorn.com-Frontend\src\main.tsx" />
    <None Include="wwwroot\GuildedThorn.com-Frontend\src\vite-env.d.ts" />
    <None Include="wwwroot\GuildedThorn.com-Frontend\vite.config.ts" />
    <None Include="wwwroot\index.html" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="GuildedThorn.com-Frontend\public\files\" />
    <Folder Include="GuildedThorn.com-Frontend\public\posts\" />
  </ItemGroup>

</Project>
