<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <SpaRoot>GuildedThorn.com-Frontend/</SpaRoot>
    <SpaProxyServerUrl>https://localhost:5173</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <SpaProxyApplyProxyToSpaDevelopmentServer>true</SpaProxyApplyProxyToSpaDevelopmentServer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNet.Security.OAuth.Spotify" Version="9.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.0-preview.3.25172.1" />
    <PackageReference Include="OpenIddict.AspNetCore" Version="6.3.0" />
    <PackageReference Include="OpenIddict.Client.AspNetCore" Version="6.3.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.1" />
  </ItemGroup>

  <!-- On publish: install and build Vite app (which outputs to wwwroot directly) -->
  <Target Name="BuildReactApp" BeforeTargets="Publish">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
  </Target>

</Project>
